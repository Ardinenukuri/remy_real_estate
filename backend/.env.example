# Server Setup
PORT=4000
NODE_ENV=development

# PostgreSQL Connection
# Local dev: fill in the discrete DB_* vars below.
# Production: set DATABASE_URL instead (provided by Neon/Supabase/Render) and
# leave the DB_* vars unset - DATABASE_URL takes priority when present.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=real_estate
# Set to true if your Postgres provider requires SSL (most hosted ones do).
# Auto-enabled when NODE_ENV=production.
DB_SSL=false

# Security & JWT
# Required in production - must not be the insecure default checked into source.
JWT_SECRET=
JWT_EXPIRATION=7d

# File Storage / CDN (Media Uploads - avatars, property photos, realtor CVs)
# Free account: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Your deployed frontend origin(s), comma-separated. Used for CORS.
FRONTEND_URL=http://localhost:3000
